# ---- API ----
NODE_ENV=development
PORT=3000
# Данные граждан РК хранятся в РК (Yandex Cloud kz1). Локально:
DATABASE_URL=postgresql://freshmarket:freshmarket@localhost:5432/freshmarket?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# ---- OTP провайдеры (только официальные каналы) ----
OTP_DEFAULT_CHANNEL=telegram
TELEGRAM_GATEWAY_TOKEN=
# SMS — SMSC.kz (docs/30)
SMSC_LOGIN=
SMSC_PASSWORD=
SMS_SENDER_NAME=Kartop
# WhatsApp — Meta Cloud API, шаблон Authentication
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=kartop_otp
# 1 — важные статусы заказа покупателю без приложения по SMS
NOTIFY_SMS_FALLBACK=0
# ---- Карты ----
MAP_PROVIDER=maplibre_osm
PMTILES_URL=https://cdn.example.kz/tiles/almaty.pmtiles
# ---- Биллинг магазинов (Kaspi Pay) ----
KASPI_MERCHANT_ID=
KASPI_API_KEY=
