// FreshMarket / Kartop — модель данных (см. docs/03-architecture.md)
// Деньги — в тиынах (Int, minor units). Вес — в граммах (Int). Время — UTC.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  PICKER
  COURIER
  PLATFORM_ADMIN
  SUPPORT
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum DeliveryMode {
  OWN
  SERVICE
  BOTH
}

enum Unit {
  KG
  G
  PCS
  BUNCH
  PACK
}

enum OrderStatus {
  CREATED
  PLACED
  ACCEPTED
  PICKING
  AWAITING_CUSTOMER
  READY
  COURIER_ASSIGNED
  DELIVERING
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PayMethod {
  CASH
  CARD_COURIER
  KASPI_TRANSFER
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum PartnerLeadStatus {
  NEW        // заявка пришла, с партнёром ещё не связались
  CONTACTED  // связались
  CONVERTED  // завели магазин (invite-only)
  REJECTED   // отказ
}

enum CatalogRequestType {
  CATEGORY
  PRODUCT
}

enum CatalogRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  email        String?  @unique // привязка email↔телефон: код можно слать на почту (дешевле SMS)
  name         String?
  platformRole Role?    // сотрудник платформы (PLATFORM_ADMIN / SUPPORT); null — обычный пользователь
  passwordHash String?  // вход сотрудников платформы по паролю (без OTP — дешевле); bcrypt
  createdAt    DateTime @default(now())
  members      StoreMember[]
  orders       Order[]
  devices      Device[]
  pushTokens   PushToken[]
}

// Transactional outbox: доменные события пишутся в одной транзакции с изменением состояния.
// Диспетчер доставляет их в пуши/SMS (at-least-once, идемпотентно).
model OutboxEvent {
  id            String    @id @default(uuid())
  type          String    // order.accepted, order.substitution_needed, billing.invoice_issued, …
  aggregateType String    // order | subscription
  aggregateId   String
  payload       Json?
  attempts      Int       @default(0)
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  @@index([processedAt, createdAt])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  platform  String   // android | ios | web
  // Приложение: merchant (приложение магазина) | customer (приложение покупателя) — у одного номера могут быть оба.
  app       String   @default("merchant")
  token     String   @unique
  createdAt DateTime @default(now())
  @@index([userId])
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  label        String?
  trustedUntil DateTime?  // доверенное устройство: код не спрашиваем до этой даты
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  channel   String   // telegram | sms | whatsapp
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([phone])
}

model Category {
  id        String     @id @default(uuid())
  parentId  String?
  parent    Category?  @relation("CatTree", fields: [parentId], references: [id])
  children  Category[] @relation("CatTree")
  name      Json       // i18n { ru, kk, en }
  perishable Boolean   @default(false) // мясо, молочка, салаты — скоропорт
  coldChain  Boolean   @default(false)
  sort      Int        @default(0)
  products  MasterProduct[]
}

model MasterProduct {
  id          String  @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        Json
  unit        Unit
  stepG       Int?     // шаг веса, г
  avgPieceG   Int?     // ≈ вес 1 шт
  perishable  Boolean  @default(false)
  storage     String?  // условия хранения
  media       Json?
  storeProducts StoreProduct[]
}

model Store {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  status    StoreStatus @default(PENDING)
  phone     String?
  kaspiPhone String?
  address   String?
  geom      Json?       // точка магазина
  // Какие доставки есть у магазина: OWN — своя (по зонам), SERVICE — курьерская служба (Яндекс и др., за счёт покупателя), BOTH — обе.
  deliveryMode DeliveryMode @default(BOTH)
  // Самовывоз: клиент забирает сам. pickupLeadMinutes — минимум времени от оформления до готовности к выдаче.
  pickupEnabled     Boolean @default(true)
  pickupLeadMinutes Int     @default(60)
  // Своя доставка магазина включена (выключена — только самовывоз).
  deliveryEnabled Boolean @default(true)
  // Доставка курьерской службой: через сколько минут после оформления заказ готов к передаче курьеру.
  courierHandoverMinutes Int @default(30)
  // Своя доставка магазина: средняя продолжительность от оформления до вручения (минуты).
  ownDeliveryMinutes Int @default(60)
  // Часы работы: 7 дней (пн первый), { open, close } 'HH:MM' по Алматы или null — выходной. Пусто — 08:00–22:00.
  hours Json?
  rating    Float    @default(0)
  reviewCount Int    @default(0)
  settings  Json?
  // Фото магазина (витрина/вход) — доверие покупателя. JPEG до ~1 МБ прямо в БД; photoAt — версия для кэша.
  photo     Bytes?
  photoType String?
  photoAt   DateTime?
  createdAt DateTime @default(now())
  members   StoreMember[]
  products  StoreProduct[]
  zones     DeliveryZone[]
  orders    Order[]
  reviews   Review[]
  subscription Subscription?
  catalogRequests CatalogRequest[]
}

model StoreMember {
  storeId String
  userId  String
  role    Role
  store   Store @relation(fields: [storeId], references: [id])
  user    User  @relation(fields: [userId], references: [id])
  @@id([storeId, userId])
}

model StoreProduct {
  id              String @id @default(uuid())
  storeId         String
  masterProductId String
  store           Store @relation(fields: [storeId], references: [id])
  master          MasterProduct @relation(fields: [masterProductId], references: [id])
  priceTiyn       Int
  oldPriceTiyn    Int?
  inStock         Boolean @default(true)
  @@unique([storeId, masterProductId])
}

model DeliveryZone {
  id        String @id @default(uuid())
  storeId   String
  store     Store  @relation(fields: [storeId], references: [id])
  polygon   Json   // GeoJSON (в БД — geography/PostGIS)
  feeTiyn   Int
  minOrderTiyn Int
  freeFromTiyn Int?
}

model Order {
  id            String   @id @default(uuid())
  number        Int      @default(autoincrement())
  storeId       String
  customerId    String?
  store         Store @relation(fields: [storeId], references: [id])
  customer      User? @relation(fields: [customerId], references: [id])
  status        OrderStatus @default(CREATED)
  // Код подтверждения получения: покупатель называет его курьеру при передаче заказа.
  // Магазину код не показываем — он только сверяет названный (защита-«страховка»).
  deliveryCode  String?
  // Способ получения: доставка или самовывоз. pickupAt — выбранное время самовывоза.
  fulfillment   Fulfillment @default(DELIVERY)
  // Кто везёт: OWN — магазин (цена по зоне), SERVICE — курьерская служба, оплачивает покупатель отдельно. null — самовывоз.
  deliveryBy    DeliveryMode?
  pickupAt      DateTime? // желаемое время получения: самовывоз — когда заберёт, доставка — к какому времени привезти
  // ПДн доступны магазину только после ACCEPTED (фильтрация в DTO по статусу)
  address       Json?
  payMethod     PayMethod @default(CASH)
  subtotalTiyn  Int @default(0)
  deliveryFeeTiyn Int @default(0)
  finalTiyn     Int?
  createdAt     DateTime @default(now())
  items         OrderItem[]
  events        OrderEvent[]
  review        Review?
}

// Оценка и отзыв покупателя после доставки/выдачи. Один отзыв на заказ.
model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  customerId String?
  rating     Int      // 1..5
  comment    String?
  createdAt  DateTime @default(now())
  @@index([storeId])
}

model OrderItem {
  id            String @id @default(uuid())
  orderId       String
  order         Order @relation(fields: [orderId], references: [id])
  storeProductId String
  qtyRequestedG Int?   // для весовых — граммы
  qtyRequested  Int?   // для штучных
  qtyActualG    Int?
  priceSnapTiyn Int
  status        String @default("ok") // ok | replaced | missing
}

model OrderEvent {
  id      String @id @default(uuid())
  orderId String
  order   Order @relation(fields: [orderId], references: [id])
  from    String?
  to      String
  actor   String?
  at      DateTime @default(now())
}

model Subscription {
  id        String @id @default(uuid())
  storeId   String @unique
  store     Store @relation(fields: [storeId], references: [id])
  plan      String // free | pro | business
  priceTiyn Int
  status    String @default("active")
  nextInvoiceAt DateTime?
  invoices  Invoice[]
}

model Invoice {
  id             String @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  period         String // YYYY-MM
  amountTiyn     Int
  status         InvoiceStatus @default(DRAFT)
  kaspiInvoiceId String?
  issuedAt       DateTime?
  paidAt         DateTime?
  @@unique([subscriptionId, period]) // один счёт за месяц (идемпотентность)
}

// Заявка «Стать партнёром» (лид мерчанта) с сайта/приложения. Свободной регистрации нет —
// платформа связывается по телефону и заводит магазин вручную (invite-only). docs/22 §invite.
model PartnerLead {
  id        String            @id @default(uuid())
  name      String            // обязательное
  phone     String            // обязательное, +77XXXXXXXXX
  company   String?           // название компании — необязательно
  twogisUrl String?           // ссылка/карточка 2ГИС — необязательно
  source    String            @default("web") // web | merchant_app
  status    PartnerLeadStatus @default(NEW)
  note      String?           // внутренняя пометка платформы
  createdAt DateTime          @default(now())
  @@index([status, createdAt])
  @@index([phone])
}

// Заявка магазина на добавление категории/товара в мастер-каталог. Админ одобряет/отклоняет.
model CatalogRequest {
  id           String               @id @default(uuid())
  storeId      String
  store        Store                @relation(fields: [storeId], references: [id])
  requestedBy  String?              // userId, кто подал
  type         CatalogRequestType
  name         String               // предлагаемое название товара/категории
  categoryId   String?              // для товара: в какую существующую категорию
  categoryName String?              // или имя новой категории (если подходящей нет)
  unit         Unit?                // для товара
  note         String?              // комментарий магазина
  status       CatalogRequestStatus @default(PENDING)
  resultId     String?              // id созданной категории/товара после одобрения
  createdAt    DateTime             @default(now())
  @@index([status, createdAt])
  @@index([storeId])
}

// Отзывы о работе сервиса: покупатели (сайт/приложение) и магазины (приложение магазина).
// Предложения новых товаров магазинами — отдельно, CatalogRequest.
enum FeedbackSource {
  CUSTOMER
  MERCHANT
}

enum FeedbackKind {
  IDEA
  PROBLEM
  COMPLAINT
  PRAISE
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  DONE
}

model Feedback {
  id        String         @id @default(uuid())
  source    FeedbackSource
  kind      FeedbackKind
  text      String
  phone     String?        // как связаться (покупатель может оставить номер)
  userId    String?        // автор, если вошёл (магазин — всегда)
  storeId   String?        // магазин, о котором/от которого отзыв
  storeSlug String?
  page      String?        // страница, откуда написали
  status    FeedbackStatus @default(NEW)
  note      String?        // заметка команды
  createdAt DateTime       @default(now())
  @@index([status, createdAt])
}

// Центр уведомлений: всё, что отправлено пользователю (магазину или покупателю), с отметкой «прочитано».
model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    // order.placed, order.ready, …
  refId     String?   // id заказа/счёта
  title     String
  body      String
  url       String?   // куда вести покупателя (страница заказа)
  // Кому: merchant — в приложении магазина, customer — покупателю (сайт/приложение покупателя).
  app       String    @default("merchant")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, createdAt])
}
